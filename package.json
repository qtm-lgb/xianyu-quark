{
  "name": "xianyu-quark",
  "version": "1.0.0",
  "description": "X 夸克资源 -> 闲鱼自动上架与自动发货流水线",
  "main": "src/pipeline.js",
  "scripts": {
    "login:x": "node src/login_x_manual.js",
    "login:fish": "node src/login_fish_qr.js",
    "check": "node src/check_login.js",
    "test": "node tools/selftest.js",
    "scrape": "node src/scrape_x.js --mode intercept --max 20",
    "probe": "node src/probe_quark.js --file",
    "build": "node src/build_listings.js",
    "publish:dry": "node src/publish_xianyu.js --dry-run",
    "publish": "node src/publish_xianyu.js",
    "listen": "node src/auto_reply.js",
    "delivery": "node src/auto_delivery.js --all",
    "pipeline": "node src/pipeline.js --publish",
    "all": "node src/pipeline.js --publish --listen"
  },
  "dependencies": {
    "playwright": "1.64.1"
  }
}
